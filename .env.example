# Copy this file to .env and change the values for your machine
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/enrolldb"
PORT=3000

# --- Deploying to Vercel + Neon ---
# Local .env (used only to run `npm run migrate:deploy` once against Neon):
#   DATABASE_URL="<Neon DIRECT connection string>"
# Vercel project env var (used by the deployed app at runtime):
#   DATABASE_URL="<Neon POOLED connection string, host ends in -pooler>"
# See README.md for the full deploy steps.
